# claimcheck.toml: copy to the repository root and edit.

[verify]
results_dir = "results"                   # where tracked manifests (*.json) live
documents   = ["RESULTS.md", "paper/main.tex"]   # documents that publish numbers
require_cited = true                      # every tracked manifest must be cited somewhere

[audit]
documents = ["README.md", "RESULTS.md"]   # tables in these are checked against their section's manifests
index     = "results/INDEX.md"            # optional: one row per tracked manifest
allow_values = [0.5, 0.9, 0.95]           # thresholds you defined yourself: not measurements

[[audit.retractions]]
file     = "README.md"
sentence = "reaches 99% accuracy"
reason   = "the 2026-03-02 audit found the 99% was measured on the training set"
date     = "2026-03-02"
